import veri from './veri.json';

export type Egzersiz = {
  id: string;
  ad: string;
  bolge: string;
  aciklama: string;
  kaynak: string;
};

// veri.json biçimi: "Ad. Bölge: x. Açıklama ... N tekrar."
export const egzersizler: Egzersiz[] = veri.map((k) => {
  const [ad, ...kalan] = k.metin.split('. ');
  const bolgeKismi = kalan[0] ?? '';
  const bolge = bolgeKismi.replace('Bölge:', '').replace('.', '').trim();
  return {
    id: k.id,
    ad,
    bolge,
    aciklama: kalan.slice(1).join('. '),
    kaynak: k.kaynak,
  };
});

export const bul = (id?: string) => egzersizler.find((e) => e.id === id);
