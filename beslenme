

import { useCallback, useState } from 'react';
import { ScrollView, Text, View, Button } from 'react-native';
import { useFocusEffect } from 'expo-router';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { bul } from '../data/egzersizler';
import Uyari from '../components/Uyari';

type Kayit = { id: string; sonTamam: string | null };
const bugun = () => new Date().toISOString().slice(0, 10);

export default function Program() {
  const [liste, setListe] = useState<Kayit[]>([]);

  useFocusEffect(
    useCallback(() => {
      AsyncStorage.getItem('program').then((v) => setListe(JSON.parse(v ?? '[]')));
    }, [])
  );

  async function tamamla(id: string) {
    const yeni = liste.map((k) => (k.id === id ? { ...k, sonTamam: bugun() } : k));
    setListe(yeni);
    await AsyncStorage.setItem('program', JSON.stringify(yeni));
  }

  return (
    <ScrollView contentContainerStyle={{ padding: 24, gap: 12 }}>
      <Text style={{ fontSize: 22, fontWeight: '600' }}>Programım</Text>
      <Text style={{ fontSize: 12, opacity: 0.7 }}>Veriler yalnızca bu cihazda saklanır.</Text>
      {liste.length === 0 ? (
        <Text>Henüz egzersiz yok. Egzersizler sayfasından bir egzersiz ekle.</Text>
      ) : (
        liste.map((k) => (
          <View key={k.id} style={{ gap: 4 }}>
            <Text>
              {bul(k.id)?.ad} {k.sonTamam === bugun() ? '✓ bugün tamamlandı' : ''}
            </Text>
            {k.sonTamam !== bugun() && <Button title="Tamamlandı" onPress={() => tamamla(k.id)} />}
          </View>
        ))
      )}
      <Uyari />
    </ScrollView>
  );
}

